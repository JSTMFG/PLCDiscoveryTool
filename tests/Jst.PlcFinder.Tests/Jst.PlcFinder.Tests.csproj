<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Jst.PlcFinder/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../src/Jst.EchoAgent/RestartCoordinator.cs" Link="EchoAgent/RestartCoordinator.cs" />
    <PackageReference Include="libplctag.NativeImport" Version="1.0.41" />
  </ItemGroup>
</Project>
