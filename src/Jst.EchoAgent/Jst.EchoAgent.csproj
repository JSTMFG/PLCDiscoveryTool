<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JST Echo Reset Agent</AssemblyName>
    <ApplicationIcon>../Jst.PlcFinder/Assets/JstEchoAgent.ico</ApplicationIcon>
    <RootNamespace>Jst.EchoAgent</RootNamespace>
    <Version>1.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Jst.PlcFinder/Core/EchoContracts.cs" Link="Core/EchoContracts.cs" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
