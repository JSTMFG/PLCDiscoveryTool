<Application x:Class="Jst.PlcFinder.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Brand" Color="#0C2D83"/>
    <SolidColorBrush x:Key="AppBackground" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppText" Color="#17233A"/>
    <SolidColorBrush x:Key="AppMuted" Color="#657189"/>
    <SolidColorBrush x:Key="AppBorder" Color="#D7DDE8"/>
    <SolidColorBrush x:Key="AppInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppHeader" Color="#EDF1F8"/>
    <SolidColorBrush x:Key="AppAlternate" Color="#FAFBFD"/>
    <SolidColorBrush x:Key="AppGridLine" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="AppStatus" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="AppSummary" Color="#EDF2FF"/>
    <SolidColorBrush x:Key="AppHint" Color="#7C879A"/>
    <SolidColorBrush x:Key="AppSuccess" Color="#167443"/>
    <SolidColorBrush x:Key="AppAlert" Color="#A55A00"/>
    <SolidColorBrush x:Key="AppBadge" Color="#DCE7FF"/>
    <SolidColorBrush x:Key="AppAccentText" Color="#0C2D83"/>
    <SolidColorBrush x:Key="AppNeutralBadge" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="AppWarmBadge" Color="#FFE0A6"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource AppInput}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="{DynamicResource AppInput}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="{DynamicResource AppInput}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource AppInput}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource AppBackground}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppGridLine}"/><Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AppAlternate}"/><Setter Property="RowBackground" Value="{DynamicResource AppSurface}"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource AppHeader}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource AppText}"/></Style>
    <Style x:Key="FieldText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
