<Window x:Class="Jst.PlcFinder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JST PLC Finder" Width="1420" Height="860" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Brand}">
      <Grid Margin="26,15">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="White" CornerRadius="4" Padding="10" Margin="0,0,24,0"><Image Source="Assets/JST.BMP" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="JST logo"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PLC Finder" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Allen-Bradley station identification" Foreground="#C9D6FA" FontSize="13"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Taskbar mode" Click="Taskbar_Click"/><Button x:Name="OverlayButton" Content="Overlay mode" Click="Overlay_Click"/><Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"/><Button Content="Help / About" Click="About_Click" Margin="0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,20,22,12">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="NetworksColumn" Width="310"/><ColumnDefinition x:Name="NetworksGapColumn" Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="NetworksSidebar" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Search networks" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Choose the ranges to search." Foreground="{DynamicResource AppMuted}" Margin="0,5,0,18"/>
            <TextBlock Text="Network adapter" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="AdaptersBox" DisplayMemberPath="Label" SelectionChanged="Adapter_Changed" ToolTip="Discovery uses this interface. Tag connections follow Windows routing."/>
            <TextBlock x:Name="AdapterInfo" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" FontSize="12" Margin="0,6,0,15"/>
            <Grid x:Name="RangeControls">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DataGrid x:Name="RangeGrid" Height="180" RowHeight="34" SelectionMode="Single" CellEditEnding="Range_EditEnding" CanUserSortColumns="False">
                <DataGrid.Columns><DataGridTemplateColumn Header="Use" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="IP / range" Width="*" Binding="{Binding Range, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns>
              </DataGrid>
              <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="Add" Click="AddRange_Click" Padding="10,5"/><Button Content="Remove" Click="RemoveRange_Click" Padding="10,5"/><Button Content="↑" Click="MoveUp_Click" Padding="10,5"/><Button Content="↓" Click="MoveDown_Click" Padding="10,5" Margin="0"/></WrapPanel>
              <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Local subnet" Click="LocalRange_Click" Padding="10,5"/><Button Content="Clear" Click="ClearRanges_Click" Padding="10,5"/><Button Content="Defaults" Click="DefaultRanges_Click" Padding="10,5" Margin="0"/></WrapPanel>
              <TextBlock Grid.Row="3" Text="Examples: 10.10.10.X, 10.10.9.0/24,&#10;192.168.9.10-192.168.9.50, 10.10.10.20" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/>
            </Grid>
            <Expander x:Name="Advanced" Header="Advanced connection options" Margin="0,12,0,0">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Controller routes (blank = direct)" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="RoutesBox" Margin="0,5,0,4" ToolTip="A route is port,slot. Example: 1,0. Separate processors with semicolons: 1,0;1,2"/>
                <TextBlock Text="Example: 1,0;1,2 for two chassis slots. Repeat the scan after changing routes." FontSize="11" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>
                <TextBlock Text="Program scope (optional)" FontSize="12" Margin="0,12,0,4"/><TextBox x:Name="ScopeBox"/>
                <TextBlock Text="Software date type" FontSize="12" Margin="0,12,0,4"/><ComboBox x:Name="SoftwareFormatBox"/>
                <TextBlock Text="GEM date type" FontSize="12" Margin="0,12,0,4"/><ComboBox x:Name="GemFormatBox"/>
                <TextBlock Text="Numeric dates are shown as raw values." FontSize="11" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,5,0,6"/>
                <CheckBox x:Name="InvertBox" Content="Simulation is ON when bit is 0" FontSize="12" Margin="0,6,0,10"/>
                <TextBlock Text="Large scan confirmation threshold" FontSize="12" Margin="0,4,0,4"/><TextBox x:Name="ThresholdBox" Text="4096"/>
                <Separator Margin="0,14,0,10"/>
                <TextBlock Text="Logix Echo reset agent" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="Agent HTTPS address" FontSize="11" Foreground="{DynamicResource AppMuted}" Margin="0,6,0,3"/><TextBox x:Name="EchoAddressBox"/>
                <Button x:Name="EchoConnectButton" Content="Connect Echo agent" Click="EchoConnect_Click" Margin="0,8,0,0"/>
                <TextBlock x:Name="EchoStatusText" Text="Not connected" FontSize="11" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock Text="Remote subnets need a working network route. This app does not change your PC's IP configuration." TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" FontSize="12" Margin="0,12,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
          <Border Background="{DynamicResource AppSummary}" CornerRadius="5" Padding="12" Margin="0,12,0,10"><StackPanel><TextBlock x:Name="RangeSummary" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DurationSummary" FontSize="12" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
          <Button x:Name="ScanButton" Content="Scan selected ranges" Background="{DynamicResource Brand}" Foreground="White" FontWeight="SemiBold" Padding="14,12" Margin="0,0,0,8" Click="Scan_Click"/>
          <Button x:Name="DiscoverButton" Content="Discover local network" Margin="0" Click="Broadcast_Click" ToolTip="Broadcast discovery on the selected adapter's local subnet only."/>
        </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="NetworksToggleButton" Content="☰" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center" Click="NetworksToggle_Click" ToolTip="Hide search networks" AutomationProperties.Name="Hide search networks"/>
          <StackPanel Grid.Column="1"><TextBlock Text="Stations" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CountsText" Text="Ready to discover your PLCs" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" Margin="0"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="FilterBox" TextChanged="Filter_Changed" ToolTip="Filter by station name or IP" AutomationProperties.Name="Filter by station name or IP"/><TextBlock Text="Search IP address or station name" Foreground="{DynamicResource AppHint}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <CheckBox x:Name="MonitorBox" Content="Auto-refresh every" VerticalAlignment="Center" Checked="Monitor_Checked" Unchecked="Monitor_Unchecked"/>
            <TextBox x:Name="RefreshIntervalBox" Width="48" Text="5" TextAlignment="Center" Margin="6,0" LostFocus="RefreshInterval_LostFocus" KeyDown="RefreshInterval_KeyDown" ToolTip="Auto-refresh interval in seconds (2–3600)"/>
            <TextBlock Text="sec" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AppSurface}" CornerRadius="8" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="DevicesGrid" MinColumnWidth="80" IsReadOnly="False" SelectionMode="Single" ClipboardCopyMode="IncludeHeader" Sorting="Device_Sorting" CellEditEnding="Tracking_EditEnding" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="IP address" Binding="{Binding IpDisplay}" SortMemberPath="IpSort" Width="135" MinWidth="135"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="Station name" Binding="{Binding Station}" Width="*" MinWidth="175"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Station}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTemplateColumn Header="Connection" Width="145" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusToolTip}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppMuted}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Foreground" Value="{DynamicResource AppSuccess}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Partial"><Setter Property="Foreground" Value="{DynamicResource AppAlert}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Station tags not found"><Setter Property="Foreground" Value="{DynamicResource AppAlert}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Tag read timeout"><Setter Property="Foreground" Value="{DynamicResource AppAlert}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Tag read failed"><Setter Property="Foreground" Value="{DynamicResource AppAlert}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Type" Width="110" SortMemberPath="DeviceKind"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="3" Padding="6,3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsEcho}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBadge}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding DeviceKind}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentText}" ToolTip="{Binding Identity.Product}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Software date" Binding="{Binding SoftwareDate}" Width="145" MinWidth="135" ElementStyle="{StaticResource FieldText}"/>
                <DataGridTextColumn Header="GEM date" Binding="{Binding GemDate}" Width="145" MinWidth="135" ElementStyle="{StaticResource FieldText}"/>
                <DataGridTemplateColumn Header="Simulation" Width="110" SortMemberPath="Simulation"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="3" Padding="6,3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppNeutralBadge}"/><Style.Triggers><DataTrigger Binding="{Binding Simulation}" Value="ON"><Setter Property="Background" Value="{DynamicResource AppWarmBadge}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Simulation}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Simulation}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Reset PLC" Width="105" MinWidth="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Reset" Click="ResetEchoRow_Click" IsEnabled="{Binding IsEcho}" Padding="10,4" Margin="4,2" ToolTip="Restart this controller through the authenticated Logix Echo agent"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Find your stations" FontSize="22" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="Enable a search range, then select Scan.&#10;IP addresses and station names will appear here." TextAlignment="Center" Foreground="{DynamicResource AppMuted}" Margin="0,12,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource AppStatus}"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready · No scan running" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><ProgressBar x:Name="ScanProgress" Grid.Column="1" Height="5" VerticalAlignment="Center" Foreground="{DynamicResource Brand}"/></Grid></Border>
  </Grid>
</Window>


