<Window x:Class="Jst.PlcFinder.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC Finder · Overlay" Width="560" Height="280" MinWidth="420" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ModeText}" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="ModeBackground" Color="#10243E"/>
    <SolidColorBrush x:Key="ModeAlternate" Color="#142C49"/>
    <SolidColorBrush x:Key="ModeHeader" Color="#172F50"/>
    <SolidColorBrush x:Key="ModeButton" Color="#203F66"/>
    <SolidColorBrush x:Key="ModeHover" Color="#315781"/>
    <SolidColorBrush x:Key="ModeBorder" Color="#365579"/>
    <SolidColorBrush x:Key="ModeText" Color="#E6EEFF"/>
    <SolidColorBrush x:Key="ModeMuted" Color="#AFC9EB"/>
    <SolidColorBrush x:Key="ModeSelected" Color="#2C507B"/>
    <SolidColorBrush x:Key="ModeGridLine" Color="#203957"/>
    <SolidColorBrush x:Key="ModeAlert" Color="#FFD28B"/>
    <SolidColorBrush x:Key="ModeSuccess" Color="#92DFBD"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ModeText}"/><Setter Property="Background" Value="{DynamicResource ModeButton}"/><Setter Property="BorderBrush" Value="{DynamicResource ModeBorder}"/>
      <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ModeHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ModeHeader}"/><Setter Property="Foreground" Value="{DynamicResource ModeMuted}"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource ModeText}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ModeSelected}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ModeSelected}"/><Setter Property="Foreground" Value="{DynamicResource ModeText}"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Border Background="{DynamicResource ModeBackground}" BorderBrush="{DynamicResource ModeBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="Header_Drag" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Stations" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Drag to move overlay"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="RefreshControl" Content="Refresh"/><Button x:Name="SettingsControl" Content="Settings"/>
          <Button x:Name="RestoreControl" Content="Main window" ToolTip="Return to the full application"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <DataGrid x:Name="StationGrid" Background="{DynamicResource ModeBackground}" RowBackground="{DynamicResource ModeBackground}" AlternatingRowBackground="{DynamicResource ModeAlternate}" Foreground="{DynamicResource ModeText}"
                  IsReadOnly="True" RowHeight="30" ColumnHeaderHeight="28" FontSize="12" HorizontalGridLinesBrush="{DynamicResource ModeGridLine}" CanUserDeleteRows="False" CanUserReorderColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="EmptyText" Text="No matching stations. Open the main window to scan or change the filter." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Foreground="{DynamicResource ModeMuted}" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="StatusControl" Grid.Row="2" FontSize="10" Foreground="{DynamicResource ModeMuted}" Margin="2,8,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <Thumb Grid.Row="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_Drag" ToolTip="Resize overlay">
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M 4,12 L 12,4 M 8,12 L 12,8" Stroke="{DynamicResource ModeMuted}" StrokeThickness="1.5"/></Grid></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>


