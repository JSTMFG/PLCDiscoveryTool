<UserControl x:Class="Jst.PlcFinder.TaskbarWidgetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Foreground="{DynamicResource ModeText}" MouseDoubleClick="Widget_DoubleClick" ToolTipService.ShowDuration="20000">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ModeBackground" Color="#10243E"/>
    <SolidColorBrush x:Key="ModeAlternate" Color="#142C49"/>
    <SolidColorBrush x:Key="ModeHeader" Color="#172F50"/>
    <SolidColorBrush x:Key="ModeButton" Color="#203F66"/>
    <SolidColorBrush x:Key="ModeHover" Color="#315781"/>
    <SolidColorBrush x:Key="ModeBorder" Color="#365579"/>
    <SolidColorBrush x:Key="ModeText" Color="#E6EEFF"/>
    <SolidColorBrush x:Key="ModeMuted" Color="#AFC9EB"/>
    <SolidColorBrush x:Key="ModeSelected" Color="#2C507B"/>
    <SolidColorBrush x:Key="ModeGridLine" Color="#203957"/>
    <SolidColorBrush x:Key="ModeAlert" Color="#FFD28B"/>
    <SolidColorBrush x:Key="ModeSuccess" Color="#92DFBD"/>  </UserControl.Resources>
  <UserControl.ToolTip><ToolTip><StackPanel><TextBlock Text="Scroll up/down for previous/next PLC · Double-click to open PLC Finder · Right-click for options"/><TextBlock Text="{Binding IpDisplay}"/><TextBlock Text="{Binding Station, StringFormat=Station: {0}}"/><TextBlock Text="{Binding TrackingValues[0], StringFormat=Developer: {0}}"/><TextBlock Text="{Binding Simulation, StringFormat=Simulation: {0}}"/><TextBlock Text="{Binding Status}"/></StackPanel></ToolTip></UserControl.ToolTip>
  <UserControl.ContextMenu><ContextMenu Placement="Top">
    <MenuItem Header="Open PLC Finder" Click="Open_Click"/><MenuItem x:Name="SettingsItem" Header="Settings…" Click="Settings_Click"/>
    <MenuItem Header="Next PLC" Click="Next_Click"/><MenuItem x:Name="HideItem" Header="Hide this PLC from scrolling" Click="Hide_Click"/><Separator/><MenuItem Header="Exit PLC Finder" Click="Exit_Click"/>
  </ContextMenu></UserControl.ContextMenu>
  <Border Background="{DynamicResource ModeBackground}" BorderBrush="{DynamicResource ModeBorder}" BorderThickness="1" CornerRadius="5" Padding="9,2" Cursor="Hand">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
      <Grid x:Name="StationContent">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="IpText" Text="{Binding IpDisplay}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock x:Name="StationNameText" Grid.Row="1" Text="{Binding Station}" Foreground="{DynamicResource ModeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Station}"/>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="SimulationText" Text="{Binding Simulation, StringFormat=SIM {0}}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="77">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ModeMuted}"/><Style.Triggers><DataTrigger Binding="{Binding Simulation}" Value="ON"><Setter Property="Foreground" Value="{DynamicResource ModeAlert}"/></DataTrigger><DataTrigger Binding="{Binding Simulation}" Value="Off"><Setter Property="Foreground" Value="{DynamicResource ModeSuccess}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="CountText" FontSize="9" Foreground="{DynamicResource ModeMuted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="DeveloperText" Text="{Binding TrackingValues[0]}" Foreground="{DynamicResource ModeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="108" HorizontalAlignment="Right" ToolTip="{Binding TrackingValues[0]}"/>
      </StackPanel>
      <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2" Text="No PLCs to display · Open Settings to change filter" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
  </Border>
</UserControl>


